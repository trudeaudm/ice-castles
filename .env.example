# Local development needs none of these — SQLite and a default password are used.

# Admin dashboard password. SET THIS before deploying anywhere public.
ADMIN_PASSWORD=change-me

# Leave unset to use SQLite. On Render, paste the Internal Database URL here.
# DATABASE_URL=postgresql://user:pass@host/dbname

# Only needed if the QR codes must point at a domain that differs from the
# host serving the request (a custom domain in front of Render, for example).
# PUBLIC_BASE_URL=https://map.icecastles.com

# Where the SQLite file lives when DATABASE_URL is unset.
# DATA_DIR=./data

PORT=3000
